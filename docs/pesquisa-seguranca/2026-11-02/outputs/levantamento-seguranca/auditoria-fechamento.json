  "pendencias_classificadas": [
    {
      "id": "P-01",
      "tema": "Correspondência documental das linhas legadas de direção e assentos",
      "itens": [
        "ENS-3-01",
        "ENS-3-02",
        "ENS-3-05"
      ],
      "questao": "Para direção, confirmar a correspondência técnica atual das linhas legadas. Para ancoragem, a base atual 951/2022 com 997/2023 está confirmada; resta delimitar a cobertura do método e da linha documental Ancoragem dos assentos sem confundir banco, cinto, apoio de cabeça e ISOFIX.",
      "efeito": "Manter as referências atuais identificadas e separar dúvida de entrega documental de existência de legislação. Não criar relatório independente por simples rótulo legado.",
      "fonte_para_resolver": "Dispositivos e escopo dos métodos da 951/2022 alterada pela 997/2023; regras procedimentais de comprovação do CAT.",
      "classificacao_para_fechamento": "revisao_documental_aberta",
      "parecer": "Direção e cobertura da ancoragem de assentos: a base 951/2022 + 997/2023 está identificada; falta fechar a equivalência entre escopo técnico, método e linha de comprovação. Isso não é ausência de legislação atual de ancoragem."
    },
    {
      "id": "P-02",
      "tema": "Mangueiras flexíveis como relatório separado",
      "itens": [
        "ENS-2-07"
      ],
      "questao": "A linha do SISCAT não corresponde a uma linha separada na tabela 1.3 do Anexo XI revisado.",
      "efeito": "Manter componente ligado ao freio; entrega autônoma pendente de fundamento.",
      "classificacao_para_fechamento": "revisao_documental_aberta",
      "parecer": "Mangueiras de freio: componente vinculado ao sistema de freios. A exigência de relatório autônomo na linha legada não foi demonstrada; não dispensar nem criar entrega por inferência."
    },
    {
      "id": "P-03",
      "tema": "Metadados da Resolução 224",
      "itens": [
        "ENS-2-02"
      ],
      "questao": "Índice/base/PDF e publicação HTML apresentam divergência de ano. Anexo XI e SISCAT citam 224/2007.",
      "efeito": "Usar identificador estável e mostrar a divergência; não fabricar data única saneada.",
      "classificacao_para_fechamento": "divergencia_preservada",
      "parecer": "Resolução 224: conflito de ano permanece exposto e rastreável. Não bloqueia a captura ou a arquitetura, mas requer aviso na ficha e identificação documental consistente."
    },
    {
      "id": "P-05",
      "tema": "Métodos de ensaio e normas técnicas incorporadas",
      "itens": [],
      "questao": "Esta entrega mapeia atos e dispositivos. Nem todos os métodos extensos dos anexos e textos privados ABNT/ISO foram convertidos em critérios executáveis; edições somente podem vir do ato ou de fonte licenciada.",
      "efeito": "Não apresentar esta matriz como certificação de engenharia ou motor completo de aprovação de relatórios.",
      "classificacao_para_fechamento": "validacao_tecnica_posterior",
      "parecer": "Métodos, amostras e critérios de aceitação precisam ser detalhados antes de o aplicativo avaliar suficiência de relatórios. O catálogo de requisitos pode ser usado como base de implementação."
    },
    {
      "id": "P-06",
      "tema": "Atualidade e fronteiras de cobertura",
      "itens": [],
      "questao": "Índice CONTRAN consultado em 31/10/2026, cuja última alteração anunciada era 06/10/2026. A busca adicional não equivale a varredura certificada de todas as edições do DOU posteriores; o índice tem inconsistências demonstradas, como a situação da 220/2007.",
      "efeito": "Não declarar fechamento integral de toda a legislação CONTRAN. Confirmar publicações recentes e regras complementares antes de liberar respostas automáticas.",
      "classificacao_para_fechamento": "atualidade_aberta",
      "parecer": "O índice foi conferido em 31/10/2026 e anuncia alteração em 06/10/2026. Não houve varredura integral do DOU posterior nem certificação de todos os atos complementares. Não declarar cobertura legal integral até 31/10."
    },
    {
      "id": "P-07",
      "tema": "Escopos condicionais não exercitados na interface",
      "itens": [],
      "questao": "Captura feita em um processo deferido elétrico M1. Não houve submissão nem alteração para outros combustíveis, PBT, carrocerias ou tipos de CAT.",
      "efeito": "A captura é completa das dez guias visitadas; não prova exaustividade de todos os campos condicionais do SISCAT.",
      "classificacao_para_fechamento": "validacao_de_outros_perfis",
      "parecer": "As dez guias estão captadas para o exemplo elétrico M1. Outros combustíveis, massas e modalidades precisam de verificação própria; não mudar o exemplo para testar um processo real."
    },
    {
      "id": "P-08",
      "tema": "Inmetro e novos regimes da rotulagem",
      "itens": [
        "SEG-002",
        "SEG-003",
        "SEG-017",
        "SEG-024",
        "SEG-034"
      ],
      "questao": "As ligações de competência foram identificadas. A cadeia integral dos regulamentos de produto/fornecedor Inmetro, do decreto de rotulagem e de eventuais atos de execução posteriores não está certificada nesta entrega.",
      "efeito": "Não tratar a referência CONTRAN como prova suficiente de registro/certificação de componente ou de dispensa de adesão.",
      "classificacao_para_fechamento": "cadeias_complementares_abertas",
      "parecer": "Regulamentos Inmetro de produtos/fornecedores e atos posteriores de rotulagem precisam de cadeia própria. A obrigação do veículo, a conformidade do produto e a declaração na ENSV são relações diferentes."
    },
    {
      "id": "P-09",
      "tema": "Vínculo com o arquivo 3D existente",
      "itens": [],
      "questao": "IDs de componentes abaixo são semânticos. Ainda é necessário conferir quais peças existem de fato no modelo e associar seus identificadores de malha.",
      "efeito": "Não declarar o vínculo visual implementado nem inferir conformidade de medidas a partir do modelo ilustrativo.",
      "classificacao_para_fechamento": "implementacao_3d",
      "parecer": "Associar os identificadores semânticos às malhas reais do modelo na implementação. Esta tarefa não bloqueia o encerramento da captura SISCAT."
    }
  ],

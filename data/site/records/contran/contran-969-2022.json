":[],"entryIntoForceEvidence":["Art. 65. Esta Resolução entra em vigor em 1° de julho de 2022. 24/06/2022 06:59 RESOLUÇÃO CONTRAN Nº 969, DE 20 DE JUNHO DE 2022 - RESOLUÇÃO CONTRAN Nº 969, DE 20 DE JUNHO DE 2022 - DOU - Imprensa Nacional https://www.in.gov.br/en/web/dou/-/resolucao-contran-n-969-de-20-de-junho-de-2022-410033795 13/13 BRUNO EUSTÁQUIO FERREIRA CASTRO DECARVALHO Presidente do ConselhoEm exercício PAULO CÉSAR REZENDE DE CARVALHO ALVIM p/ Ministério da Ciência, Tecnologia e Inovações MARCELO LOPES DA PONTE p/ Ministério da Educação ANDRÉ LARANJA SÁ CORRÊA p/ Ministério da Defesa ARNALDO CORREIA DE MEDEIROS p/ Ministério da Saúde SILVINEI VASQUES p/Ministério da Justiça e Segurança Pública Este conteúdo não substitui o publicado na versão certiﬁcada."],"documentCheck":{"state":"extraido","sha256":"c0e48ed8cef1cf155df26cfde04a91c9670dd2b773d986b7efcaee387d48d8a8","bytes":154632,"pages":13,"url":"https://www.gov.br/transportes/pt-br/assuntos/transito/conteudo-contran/resolucoes/resolucao9692022.pdf"},"entryDateAssessment":{"datesMentioned":["2022-06-20","2022-07-01"],"note":"Datas extraídas da cláusula; múltiplas datas e referências a outros atos exigem leitura do trecho, sem decisão automática de aplicabilidade."},"temporalFlags":[],"catalogRecordIds":["senatran-063"],"systems":["identificacao"],"themes":["outros"],"classificationBasis":"Associação temática pela ementa e vínculos já existentes no catálogo; não determina obrigação ou aplicação a um veículo.","actNature":"normativa-ou-procedimental","amendedBasesRevoked":[],"statusLabel":"Vigência indicada no índice","currentIndication":true,"active":true,"vehicleLinks":[{"componentId":"identificacao","systemId":"identificacao","subsystemId":"identificacao/placas","basis":"Vínculo temático pela ementa e taxonomia do projeto; confirmar categoria, requisitos e exceções no texto."}],"regulatoryDomain":"safety","requirements":[{"title":"Placa de Identificação Veicular (PIV)","rule":"PIV dianteira e traseira após o registro, com exceções do art. 2º; especificações no Anexo I. O QR Code é o lacre eletrônico. A norma não determina troca universal de toda placa antiga.","clause":"Arts. 2º e 3º; Anexo I","scope":"Veículos registrados no território nacional, observadas as categorias e hipóteses de substituição.","evidence":"Art. 2º Após o registro no respectivo órgão ou entidade executivo de trânsito do Estado ou do Distrito Federal, cada veículo será identiﬁcado por PIV dianteira e traseira, de acordo com os requisitos estabelecidos nesta Resolução. § 1º Os reboques, semirreboques, motocicletas, motonetas, ciclomotores, cicloelétricos, triciclos, quadriciclos e guindastes serão identiﬁcados apenas pela PIV traseira. § 2º As especiﬁcações técnicas das PIV estão contidas no Anexo I. § 3º Excetuadas as situações descritas no art. 56, não será obrigatória a substituição da Placa Nacional Única (PNU), modelo de placa anteriormente estabelecido identiﬁcada por uma sequência de três caracteres alfabéticos e quatro caracteres numéricos no padrão \"AAA-1111\", pelo modelo de PIV previsto nesta Resolução. § 4º Caso os proprietários de veículos que estejam em circulação identiﬁcados pela PNU desejem adotar voluntariamente o modelo de PIV previsto nesta Resolução, haverá a substituição automática do segundo caractere numérico da PNU, conforme padrão previsto no Anexo II. § 5º Os veículos de coleção classiﬁcados como originais, conforme regulamentação especíﬁca do CONTRAN, podem ser identiﬁcados com placa especíﬁca para uso restrito ao território nacional, conforme disposições apresentadas no Anexo I.","topics":["placas"],"id":"contran-969-2022:req:01","actId":"contran-969-2022","agency":"contran","provision":{"kind":"public_text_excerpt","reference":"Arts. 2º e 3º; Anexo I","sourceUrl":"https://www.gov.br/transportes/pt-br/assuntos/transito/conteudo-contran/resolucoes/resolucao9692022.pdf"},"evidenceSource":{"url":"https://www.gov.br/transportes/pt-br/assuntos/transito/conteudo-contran/resolucoes/resolucao9692022.pdf","sourceKey":null,"actDocumentSha256":"c0e48ed8cef1cf155df26cfde04a91c9670dd2b773d986b7efcaee387d48d8a8"},"verification":{"state":"directed_review","applicability":"requires_assessment"},"context":{"vehicleLinks":[{"componentId":"identificacao","systemId":"identificacao","subsystemId":"identificacao/placas","basis":"Vínculo temático pela ementa e taxonomia do projeto; confirmar categoria, requisitos e exceções no texto."}],"activities":[{"stageId":"producao","activityId":"circulacao","stageLabel":"Produção e liberação","activityLabel":"Registro, placa e licenciamento","relation":"activity_consults_act"}],"relation":"act_context_only","note":"O sistema/atividade consulta este ato; a aplicação deste requisito ainda exige avaliação específica."},"verificationPlan":{"state":"not_structured","method":null,"expectedEvidence":[],"note":"Método, edição, limites e evidências específicas devem ser revisados antes de criar um checklist."}}],"topics":["placas","etiquetas"],"generalCategories":[],"schemaVersion":2,"legalStatus":{"state":"indicated_current","asOf":"2026-10-18","basis":"Indicação nas fontes do recorte revisado; não equivale a consolidação integral.","evidence":["Em vigor em 1° de julho de 2022"]},"reviewStatus":{"state":"directed_text_review","fullTextReviewed":null,"amendmentChainReviewed":false,"reviewedAt":"2026-10-18","gaps":[]},"applicability":{"state":"requires_assessment","vehicleSpecific":false,"basis":"Associação temática pela ementa e vínculos já existentes no catálogo; não determina obrigação ou aplicação a um veículo.","conditions":["Categoria, configuração, datas, combustível, exceções e transições precisam de enquadramento."],"phases":[]},"publication":{"included":true,"reason":"included_in_reviewed_collection","reviewedAt":"2026-10-18","policySource":"data/contran/publication-policy.json"},"requirementIds":["contran-969-2022:req:01"]}

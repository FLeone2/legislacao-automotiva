rovidências.","futureDateInEvidence":false}],"entryIntoForceEvidence":["Art. 65. Esta Resolução entra em vigor em 3 de janeiro de 2022."],"documentCheck":{"state":"extraido","sha256":"393930b1b943a95a2110bd64176f627c50c8b6b253ccbd7366e9b78fce8d9f65","bytes":1761997,"pages":27,"url":"https://www.gov.br/transportes/pt-br/assuntos/transito/conteudo-contran/resolucoes/Resolucao8822021.pdf"},"entryDateAssessment":{"datesMentioned":["2022-01-03"],"note":"Datas extraídas da cláusula; múltiplas datas e referências a outros atos exigem leitura do trecho, sem decisão automática de aplicabilidade."},"temporalFlags":[],"catalogRecordIds":["senatran-104"],"systems":["chassi","identificacao"],"themes":["outros"],"classificationBasis":"Associação temática pela ementa e vínculos já existentes no catálogo; não determina obrigação ou aplicação a um veículo.","actNature":"normativa-ou-procedimental","amendedBasesRevoked":[],"statusLabel":"Entrada em vigor localizada no texto","currentIndication":true,"active":true,"vehicleLinks":[{"componentId":"chassi","systemId":"chassi","subsystemId":"chassi/componentes","basis":"Vínculo temático pela ementa e taxonomia do projeto; confirmar categoria, requisitos e exceções no texto."},{"componentId":"identificacao","systemId":"identificacao","subsystemId":"identificacao/rotulagem","basis":"Anexo VI: inscrição de pesos e capacidades."}],"regulatoryDomain":"safety","requirements":[{"title":"Plaqueta de pesos e capacidades","rule":"Indicar pesos/capacidades nos casos abrangidos pelo Anexo VI. Plaqueta ou etiqueta deve resistir ao tempo; o anexo especifica contraste, caracteres e locais de fixação por categoria.","clause":"Anexo VI, itens 2 e 3","scope":"Veículos de tração, carga, especiais e transporte coletivo com PBT acima de 3.500 kg: conferir o campo de aplicação do Anexo VI, a categoria do veículo e as alterações vinculadas à Resolução 882/2021. Não equivale à ETA do VIN.","evidence":"3.1.1 As indicações referentes ao item 2 serão inscritas em plaqueta ou em etiqueta adesiva resistente à ação do tempo; 3.1.2 As indicações serão inscritas em fundo claro ou escuro, adotados caracteres alfanuméricos contrastantes, com altura não inferior a 3 mm. 3.1.3 Poderão ser usados letras ou números inscritos em alto ou baixo relevo, sem necessidade de contraste de cor. 3.2 Normas gerais. 24/12/2021 10:06 RESOLUÇÃO CONTRAN Nº 882, DE 13 DE DEZEMBRO DE 2021 - RESOLUÇÃO CONTRAN Nº 882, DE 13 DE DEZEMBRO DE 2021 - DOU - Imprensa Nacional https://www.in.gov.br/en/web/dou/-/resolucao-contran-n-882-de-13-de-dezembro-de-2021-370017699 27/27 3.2.1 A indicação nos veículos automotores de tração, de carga e especiais será inscrita ou aﬁxada em um dos seguintes locais, assegurada a facilidade de visualização. 3.2.1.1 Na coluna de qualquer porta, junto às dobradiças, ou no lado da fechadura. 3.2.1.2 Na borda de qualquer porta. 3.2.1.3 Na parte inferior do assento, voltada para porta. 3.2.1.4 Na superfície interna de qualquer porta. 3.2.1.5 No painel de instrumentos. 3.2.2 Nos veículos destinados ao transporte coletivo de passageiros, a indicação deverá ser aﬁxada na parte frontal interna ","topics":["etiquetas"],"id":"contran-882-2021:req:01","actId":"contran-882-2021","agency":"contran","provision":{"kind":"public_text_excerpt","reference":"Anexo VI, itens 2 e 3","sourceUrl":"https://www.gov.br/transportes/pt-br/assuntos/transito/conteudo-contran/resolucoes/Resolucao8822021.pdf"},"evidenceSource":{"url":"https://www.gov.br/transportes/pt-br/assuntos/transito/conteudo-contran/resolucoes/Resolucao8822021.pdf","sourceKey":null,"documentSha256":"393930b1b943a95a2110bd64176f627c50c8b6b253ccbd7366e9b78fce8d9f65","documentKind":"official_text_snapshot"},"verification":{"state":"directed_review","applicability":"requires_assessment"},"context":{"vehicleLinks":[{"componentId":"chassi","systemId":"chassi","subsystemId":"chassi/componentes","basis":"Vínculo temático pela ementa e taxonomia do projeto; confirmar categoria, requisitos e exceçõe